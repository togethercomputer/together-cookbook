{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "A Prometheus-compatible datasource that scrapes the Together Endpoint Metrics endpoint (/organizations/{org_id}/metrics).",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.2.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Example dashboard for Together Dedicated Endpoint metrics scraped from the external /organizations/{org_id}/metrics endpoint. Requires a Prometheus/Alloy that scrapes that endpoint. Metrics are grouped by request-path stage: edge (front-door) -> router -> worker (model server).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "together",
    "dedicated-endpoints",
    "inference"
  ],
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(edge_inference_requests_total, endpoint_id)",
        "query": "label_values(edge_inference_requests_total, endpoint_id)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(edge_inference_requests_total{endpoint_id=~\"$endpoint\"}, deployment_id)",
        "query": "label_values(edge_inference_requests_total{endpoint_id=~\"$endpoint\"}, deployment_id)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Together \u2014 Dedicated Endpoint Metrics (Example)",
  "uid": null,
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Together Dedicated Endpoint Metrics \u2014 example dashboard.** Requires a Prometheus/Alloy that scrapes `https://o11y-de2-metrics.cloud.together.ai/organizations/{org_id}/metrics` (Bearer = your Together API key). Use the **Endpoint** / **Deployment** variables to filter. Latency panels are computed from histogram buckets client-side. Note: `edge_*` latencies are in **milliseconds**; `router_*` / `worker_*` latencies are in **seconds**."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Golden signals (Edge / client-observed)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate (edge) by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "expr": "sum by (status_code) (rate(edge_inference_requests_total{endpoint_id=~\"$endpoint\",deployment_id=~\"$deployment\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error ratio (5xx, edge)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "range": true,
          "expr": "(sum(rate(edge_inference_requests_total{status_code=~\"5..\",endpoint_id=~\"$endpoint\",deployment_id=~\"$deployment\"}[$__rate_interval])) or vector(0)) / sum(rate(edge_inference_requests_total{endpoint_id=~\"$endpoint\",deployment_id=~\"$deployment\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "In-flight (edge)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
